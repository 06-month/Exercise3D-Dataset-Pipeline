# 실제 값은 commit하지 않는다. 이 파일을 참고해 shell 환경에 설정한다.
EXERCISE3D_DATASET_ROOT=/path/to/private/exercise3d
EXERCISE3D_VGGT_REPO=/path/to/local/vggt-omega
EXERCISE3D_VGGT_CHECKPOINT=/path/to/checkpoints/vggt_omega_1b_512.pt
EXERCISE3D_CHECKPOINT_ROOT=/path/to/checkpoints
SAPIENS2_ROOT=/path/to/official/sapiens2

# 별도 Python runtime이 필요한 경우에만 사용한다.
EXERCISE3D_OPEN3D_PYTHON=/path/to/python
EXERCISE3D_BACKGROUND_BA_PYTHON=/path/to/python
EXERCISE3D_SAPIENS2_PYTHON=/path/to/sapiens2/python
